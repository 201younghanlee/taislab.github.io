{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div>
        &copy; Copyright {{ site.time | date: '%Y' }} {{ site.browser_title | default: 'TAIS Lab' }}{% if site.footer_text %}. {{ site.footer_text }}{% endif %}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </div>
      <div class="footer-address">Bldg. Prime, Rm. 507, Sungshin Women's University, Seoul, Korea 02844</div>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container">
      <div>
        &copy; Copyright {{ site.time | date: '%Y' }} {{ site.browser_title | default: 'TAIS Lab' }}{% if site.footer_text %}. {{ site.footer_text }}{% endif %}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </div>
      <div class="footer-address">Bldg. Prime, Rm. 507, Sungshin Women's University, Seoul, Korea 02844</div>
    </div>
  </footer>
{% endif %}
