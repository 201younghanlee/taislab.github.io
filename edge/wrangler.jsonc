{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taislab-agent-content-negotiation",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
